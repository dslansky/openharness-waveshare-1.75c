@@ -47,3 +48,12 @@ void audio_notify_done(void);
 // Applies immediately, including queued notifications, and persists to NVS.
 bool audio_notify_set_muted(bool muted);
 bool audio_notify_is_muted(void);
+
+// --- Speech (the host's text-to-speech, streamed over the cable as 16 kHz mono 16-bit PCM) ---
+// Asked for by a person, so mute (which is for notices) does not silence it; the microphone does.
+// begin/write/end/stop are called on the cable reader task; write never blocks and drops what does not fit.
+void audio_speech_begin(void);
+void audio_speech_write(const uint8_t *pcm, size_t len);
+void audio_speech_end(void);
+void audio_speech_stop(void);
+bool audio_speech_active(void);
diff --git a/devices/harness-device/firmware/main/cable_client.c b/devices/harness-device/firmware/main/cable_client.c
index 7ddb510b8..24219391d 100644
--- a/devices/harness-device/firmware/main/cable_client.c
+++ b/devices/harness-device/firmware/main/cable_client.c
@@ -472,6 +472,22 @@ void cable_client_send_open(const char *agent_id, const char *reason)
     send_json(root);
 }
 
+// `speak` {agentId}: read this agent's latest reply aloud (CABLE_FEATURE_SPEAK). `speak.stop`: stop sending it.
+void cable_client_speak(const char *agent_id)
+{
+    if (!agent_id || !agent_id[0]) return;
+    cJSON *root = msg("speak");
+    if (!root) return;
+    msg_string(&root, "agentId", agent_id);
+    send_json(root);
+}
+
+void cable_client_speak_stop(void)
+{
+    cJSON *root = msg("speak.stop");
+    if (root) send_json(root);
+}
+
 bool cable_client_notification_read(const char *agent_id, const char *read_token)
 {
     if (!agent_id || !agent_id[0] || strlen(agent_id) >= ID_MAX ||
@@ -1599,6 +1615,10 @@ static void handle_message(const cJSON *root)
     if (strcmp(t, "form.state") == 0) { ui_form_state(p); return; }
     if (strcmp(t, "visit.state") == 0) { ui_visit_state(p); return; }
     if (strcmp(t, "toast") == 0) { ui_cable_toast(str_of(p, "text")); return; }
+    // Spoken replies: PCM frames between speak.begin and speak.end go to the speaker.
+    if (strcmp(t, "speak.begin") == 0) { audio_speech_begin(); return; }
+    if (strcmp(t, "speak.end") == 0) { audio_speech_end(); return; }
+    if (strcmp(t, "speak.stop") == 0) { audio_speech_stop(); return; }
     if (strcmp(t, "fw.offer") == 0) {
         const cJSON *size = cJSON_GetObjectItemCaseSensitive(p, "size");
         // Declining is silence: fw_update_offer() answers with `fw.accept` only when it is willing, and
@@ -1642,8 +1662,14 @@ static void on_frame(uint8_t version, uint8_t type, const uint8_t *payload, size
         handle_pet_slice(payload, payload_len);
         return;
     }
+    if (type == CABLE_TYPE_PCM) {
+        // A spoken reply (speak.begin opened it); the speech player drops it when nothing is playing.
+        s_last_rx_us = esp_timer_get_time();
+        audio_speech_write(payload, payload_len);
+        return;
+    }
     if (type != CABLE_TYPE_JSON) {
-        // PCM travels the other way; anything else is a peer that knows a payload kind this build does not.
+        // Anything else is a peer that knows a payload kind this build does not.
         s_unknown++;
         return;
     }
