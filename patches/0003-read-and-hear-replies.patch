diff --git a/devices/harness-device/firmware/main/audio_capture.c b/devices/harness-device/firmware/main/audio_capture.c
index 2418d0657..bf9b6c714 100644
--- a/devices/harness-device/firmware/main/audio_capture.c
+++ b/devices/harness-device/firmware/main/audio_capture.c
@@ -9,6 +9,9 @@
 #include "freertos/FreeRTOS.h"
 #include "freertos/task.h"
 #include "freertos/semphr.h"
+#include "freertos/stream_buffer.h"
+#include "freertos/idf_additions.h"
+#include "esp_heap_caps.h"
 #include "esp_timer.h"
 #include "esp_log.h"
 #include <string.h>
@@ -183,6 +186,89 @@ void audio_notify_done(void)
     xTaskNotifyGive(s_beep_task);
 }
 
+// --- Speech: the host's text-to-speech, streamed as PCM and played through the same ES8311 path as the beep ---
+// The host sends about a second ahead and then keeps pace, so three seconds of buffer (PSRAM) absorbs any jitter.
+#define SPEECH_BUFFER (AUDIO_SAMPLE_RATE * 2 * 3)
+#define SPEECH_QUIET_US (5 * 1000 * 1000)   // a host that stops sending mid-reply: let the speaker go
+static StreamBufferHandle_t s_speech;
+static TaskHandle_t s_speech_task;
+static atomic_bool s_speech_on, s_speech_input_done, s_speech_abort;
+
+static void speech_task(void *arg)
+{
+    (void)arg;
+    static uint8_t buf[640];   // 20 ms; static: this task is the only reader
+    while (1) {
+        ulTaskNotifyTake(pdTRUE, portMAX_DELAY);
+        if (xSemaphoreTake(s_codec_lock, pdMS_TO_TICKS(1000)) == pdTRUE) {
+            esp_codec_dev_sample_info_t fs = { .sample_rate = AUDIO_SAMPLE_RATE, .channel = 1, .bits_per_sample = 16 };
+            if (!atomic_load(&s_capture_requested) && esp_codec_dev_open(s_spk, &fs) == ESP_OK) {
+                esp_codec_dev_set_out_vol(s_spk, 90);
+                ESP_LOGI(TAG, "speech: playing");
+                size_t carry = 0;
+                int64_t heard = esp_timer_get_time();
+                // The microphone wins: a person who starts talking has stopped listening.
+                while (!atomic_load(&s_speech_abort) && !atomic_load(&s_capture_requested)) {
+                    size_t n = xStreamBufferReceive(s_speech, buf + carry, sizeof buf - carry, pdMS_TO_TICKS(40));
+                    if (n) {
+                        n += carry;
+                        size_t whole = n & ~(size_t)1;   // a slice can end mid-sample; keep the odd byte for the next
+                        if (whole && esp_codec_dev_write(s_spk, buf, (int)whole) != ESP_CODEC_DEV_OK) break;
+                        carry = n - whole;
+                        if (carry) buf[0] = buf[whole];
+                        heard = esp_timer_get_time();
+                    } else if (atomic_load(&s_speech_input_done) && xStreamBufferIsEmpty(s_speech)) {
+                        break;
+                    } else if (esp_timer_get_time() - heard > SPEECH_QUIET_US) {
+                        ESP_LOGW(TAG, "speech: host went quiet");
+                        break;
+                    }
+                }
+                esp_codec_dev_close(s_spk);
+            } else ESP_LOGW(TAG, "speech: speaker busy");
+            xSemaphoreGive(s_codec_lock);
+        }
+        xStreamBufferReset(s_speech);
+        atomic_store(&s_speech_on, false);
+        ESP_LOGI(TAG, "speech: done");
+    }
+}
+
+void audio_speech_begin(void)
+{
+    if (!s_spk) return;
+    if (!s_speech) {
+        s_speech = xStreamBufferCreateWithCaps(SPEECH_BUFFER, 1, MALLOC_CAP_SPIRAM);
+        if (!s_speech) { ESP_LOGW(TAG, "speech: no buffer"); return; }
+    }
+    // The codec-open path needs ~3 KiB (the beep task's measurement); the rest is margin.
+    if (!s_speech_task && xTaskCreate(speech_task, "speech", 6144, NULL, 5, &s_speech_task) != pdPASS) {
+        s_speech_task = NULL;
+        ESP_LOGW(TAG, "speech: no task");
+        return;
+    }
+    if (atomic_load(&s_speech_on)) {   // a new reply replaces the one still playing
+        atomic_store(&s_speech_abort, true);
+        for (int i = 0; i < 30 && atomic_load(&s_speech_on); i++) vTaskDelay(pdMS_TO_TICKS(10));
+        if (atomic_load(&s_speech_on)) return;
+    }
+    xStreamBufferReset(s_speech);
+    atomic_store(&s_speech_input_done, false);
+    atomic_store(&s_speech_abort, false);
+    atomic_store(&s_speech_on, true);
+    xTaskNotifyGive(s_speech_task);
+}
+
+void audio_speech_write(const uint8_t *pcm, size_t len)
+{
+    if (!s_speech || !atomic_load(&s_speech_on) || atomic_load(&s_speech_abort)) return;
+    xStreamBufferSend(s_speech, pcm, len, 0);
+}
+
+void audio_speech_end(void) { atomic_store(&s_speech_input_done, true); }
+void audio_speech_stop(void) { if (atomic_load(&s_speech_on)) atomic_store(&s_speech_abort, true); }
+bool audio_speech_active(void) { return atomic_load(&s_speech_on); }
+
 static bool capture_init_failed(const char *why)
 {
     if (s_mic) { esp_codec_dev_delete(s_mic); s_mic = NULL; }
